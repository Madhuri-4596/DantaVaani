# Copy to .env and fill in. Everything is optional; the app runs offline without it.

# --- Lyzr (https://studio.lyzr.ai) ---
LYZR_API_KEY=
LYZR_VOICE_AGENT_ID=
LYZR_TRIAGE_AGENT_ID=
LYZR_USER_ID=your-lyzr-login-email@example.com
# LYZR_API_URL=https://agent-prod.studio.lyzr.ai/v3/inference/chat/

# --- BAND (optional): every agent-to-agent message is POSTed here as JSON ---
BAND_WEBHOOK_URL=
BAND_API_KEY=

# --- Clinic ---
CLINIC_NAME=Smile Care Dental Clinic
DOCTOR_ON_DUTY=Dr. Ananya Rao
PORT=3000
